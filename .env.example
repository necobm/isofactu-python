# ---------------------------------------------------------------------------
# Template of the shared configuration: copy it to `.env` (git-ignored, never commit
# it) and fill in the values -- passwords and secrets only ever go in `.env`. Read by
# Docker Compose (variable substitution) and by the backend when running locally
# outside Docker. Real environment variables take precedence over `.env`.
# ---------------------------------------------------------------------------

APP_ENV=dev

###> postgres ###
POSTGRES_VERSION=17
POSTGRES_DB=isofactu
POSTGRES_USER=
POSTGRES_PASSWORD=
# Host port mapped to the database container (5433 to avoid conflicts with a local server)
POSTGRES_PORT=5433
###< postgres ###

###> backend ###
BACKEND_PORT=8000
# Bake pytest/ruff into the image (set to false for a production image)
BACKEND_INSTALL_DEV=true
# Only used when running the backend directly on the host (the container gets its own URL).
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 to (re)load generated fixtures on container start (purges existing data!)
LOAD_FIXTURES=0
FIXTURES_INVOICES=20
FIXTURES_SEED=42
###< backend ###

###> authentication ###
# Signs the session cookie. Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-key-change-me
# Session lifetime (hours)
SESSION_TTL_HOURS=168
# First SUPER_ADMIN account, created on container start when it does not exist yet.
# Leave both empty to skip (then use: make super-admin EMAIL=...). Change in production!
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
###< authentication ###

###> encryption of stored secrets ###
# Keys that encrypt the secrets kept in the database (the tenants' AI API keys), comma
# separated: the first encrypts, all decrypt. Generate one with
#   docker compose exec backend python -m app.cli secrets generate-key
# To rotate: put the new key first, run `python -m app.cli secrets rotate`, then remove the
# old one. Empty: a key derived from SECRET_KEY is used (set a real one in production, so
# that SECRET_KEY can be changed without losing the stored keys).
ENCRYPTION_KEYS=
###< encryption of stored secrets ###

###> mail ###
# Public URL of the app, used in the links sent by e-mail (activation links)
APP_PUBLIC_URL=http://localhost:8000
# Mailpit (dev): web UI on http://localhost:8025
MAILPIT_VERSION=v1.27
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Only used when running the backend directly on the host (the container always talks to
# the `mailpit` service, see compose.yaml). Leave SMTP_HOST empty to log e-mails instead.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=
###< mail ###

###> PDF import of received invoices ###
# Supplier invoices uploaded as PDF are read by an AI model through LiteLLM. Each tenant
# chooses its vendor (Gemini, Anthropic, OpenAI, Azure OpenAI, Amazon Bedrock), model and API
# key in *Ajustes*: they are stored in the database, the key encrypted (see ENCRYPTION_KEYS).
# Do NOT set vendor credentials (OPENAI_API_KEY, AWS_*...) in the server environment.
#   LLM_TIMEOUT   Seconds to wait for the model to read an invoice
LLM_TIMEOUT=120
###< PDF import of received invoices ###

###> frontend ###
FRONTEND_PORT=5173
NODE_VERSION=22
###< frontend ###
