# ---------------------------------------------------------------------------
# Shared configuration. Read by Docker Compose (variable substitution) and by the
# backend when running locally outside Docker. Override values in `.env.local`
# (git-ignored) or through real environment variables.
# ---------------------------------------------------------------------------

APP_ENV=dev

###> postgres ###
POSTGRES_VERSION=17
POSTGRES_DB=isofactu
POSTGRES_USER=app
POSTGRES_PASSWORD=vG7r9yL2qP4sZ8wHPt3KcR1u
# Host port mapped to the database container (5433 to avoid conflicts with a local server)
POSTGRES_PORT=5433
###< postgres ###

###> backend ###
BACKEND_PORT=8000
# Bake pytest/ruff into the image (set to false for a production image)
BACKEND_INSTALL_DEV=true
# Only used when running the backend directly on the host (the container gets its own URL).
DATABASE_URL=postgresql+psycopg://app:vG7r9yL2qP4sZ8wHPt3KcR1u@127.0.0.1:5433/isofactu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 to (re)load generated fixtures on container start (purges existing data!)
LOAD_FIXTURES=0
FIXTURES_INVOICES=20
FIXTURES_SEED=42
###< backend ###

###> frontend ###
FRONTEND_PORT=5173
NODE_VERSION=22
###< frontend ###
